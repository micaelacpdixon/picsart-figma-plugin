{
  "name": "picsart-figma-plugin",
  "version": "0.17.0",
  "private": true,
  "engines": {
    "node": ">=20.19 <21"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "build": "webpack",
    "build:prod": "webpack --mode production",
    "watch": "webpack --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check:bundle": "node scripts/check-bundle-boundary.mjs",
    "gate": "npm run typecheck && npm run lint && npm run test:run && npm run build && npm run check:bundle && npm run check:eval && npm run build:prod && npm run build:beta",
    "check:eval": "node scripts/check-bundle-eval.mjs",
    "build:beta": "webpack --mode production --env agentsBeta && node scripts/beta-manifest.mjs && node scripts/check-bundle-eval.mjs dist-beta/code.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@figma/eslint-plugin-figma-plugins": "^1.0.0",
    "@figma/plugin-typings": "^1.131.0",
    "@testing-library/react": "^13.4.0",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "css-loader": "^6.11.0",
    "eslint": "^9.39.4",
    "html-webpack-plugin": "^5.6.0",
    "jsdom": "^26.1.0",
    "react-dev-utils": "^12.0.1",
    "sass": "^1.63.0",
    "sass-loader": "^16.0.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.10",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  }
}

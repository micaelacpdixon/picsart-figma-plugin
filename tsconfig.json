{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "esnext", "dom.iterable"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react",
    "types": ["plugin-typings"],
    "typeRoots": ["node_modules/@types", "node_modules/@figma", "src/types"],
    "baseUrl": "./",
    "paths": {
      "@assets/*": ["assets/*"],
      "@routes/*": ["routes/*"],
      "@controllers/*": ["controllers/*"],
      "@services/*": ["services/*"],
      "@constants/*": ["constants/*"],
      "@ui_constants/*": ["src/ui_constants/*"],
      "@styles/*": ["src/styles/*"],
      "@utils/*": ["src/utils/*"],
      "@hooks/*": ["src/hooks/*"],
      "@components/*": ["src/components/*"],
      "@api/*": ["src/api/*"],
      "@ui/*": ["src/components/ui/*"],
      // Renamed from "@types/*", which shadowed the DefinitelyTyped package scope.
      "@app-types/*": ["src/types/*"]
    }
  },
  // services/__tests__ is listed explicitly: without it, `tsc --noEmit` would not
  // typecheck the sandbox tests at all, so a test could reference a function that
  // no longer exists and the gate would stay green.
  "include": [
    "src/**/*",
    "src/types/global.d.ts",
    "routes/CommandRouter.ts",
    "services/__tests__/**/*"
  ],
  "exclude": ["node_modules"]
}
